# Track only FORMA's own plugin and child theme. WordPress core, third-party plugins, uploads,
# wp-config.php, logs and the local docs/ folder never enter the repository.
/*
!/.gitignore
!/.gitattributes
!/README.md

!/wp-content/
/wp-content/*

!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/forma-studio-engine/

!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/forma-hello-child/
